# Supabase Postgres connection string. Prefer the pooler URL for Vercel runtime.
DATABASE_URL="postgresql://postgres:password@db.project.supabase.co:5432/postgres?sslmode=require"

# Supabase project URL and public browser key.
NEXT_PUBLIC_SUPABASE_URL="https://project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Server-only Supabase key. Never expose this as NEXT_PUBLIC_* or commit it.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Private Storage bucket used by /api/backups.
SUPABASE_BACKUP_BUCKET="finsight-backups"
